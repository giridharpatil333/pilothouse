<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by pilothouse service install. Changes are overwritten; edit ~/.pilothouse/config.yaml instead. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.pilothouse.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/pilothouse</string>
		<string>daemon</string>
		<string>--log-file</string>
		<string>/opt/pilothouse-test/home/logs/daemon.log</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
		<key>PILOTHOUSE_HOME</key>
		<string>/opt/pilothouse-test/home</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardErrorPath</key>
	<string>/opt/pilothouse-test/home/logs/daemon.stderr.log</string>
</dict>
</plist>
